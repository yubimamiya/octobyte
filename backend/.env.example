# Copy this file to backend/.env and fill in your real key.
# backend/.env is gitignored and must never be committed.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: any OpenRouter model id. Defaults to meta-llama/llama-3-8b-instruct:free
# OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-70b

# Hermes agent (wildfire assessment). Uses OPENROUTER_API_KEY unless HERMES_API_KEY is set.
# HERMES_API_KEY=sk-or-v1-your-hermes-key-here
# HERMES_MODEL=nousresearch/hermes-3-llama-3.1-70b
