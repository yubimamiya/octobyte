# Copy this file to frontend/.env. Vite only exposes variables prefixed with VITE_.
# frontend/.env is gitignored and must never be committed.
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token
# Backend endpoints (defaults shown; change for Render / production)
VITE_API_URL=http://localhost:8000/api/chat
VITE_WS_URL=ws://localhost:8000/ws/fire-data
